{
  "name": "wayword-shop-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix website run dev --",
    "dev:game": "vite --host 127.0.0.1",
    "build": "npm --prefix website run build",
    "build:game": "tsc --noEmit && vite build",
    "preview": "npm --prefix website run preview --",
    "test": "node --experimental-strip-types --test tests/cloud.test.ts tests/core.test.ts tests/market-world.test.ts tests/arrival-state.test.ts tests/unpack-state.test.ts tests/counting-state.test.ts website/tests/progression.test.ts website/tests/unit-unlock.test.ts",
    "test:browser": "playwright test",
    "test:website": "playwright test --config playwright.website.config.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
